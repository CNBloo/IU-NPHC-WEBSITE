# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.

# --- Sanity CMS (Phase 2) ---
# Project ID and dataset name from manage.sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
# Read-only, viewer-scoped API token. Do NOT use an editor/admin token here.
SANITY_READ_TOKEN=
# Shared secret you choose yourself; must match the secret configured on the
# Sanity webhook that calls /api/revalidate (see HANDOFF.md).
SANITY_REVALIDATE_SECRET=
# Editor-scoped token used ONLY by `npx sanity exec sanity/seed.ts` when not
# using --with-user-token. Local-only: never set this on Vercel.
SANITY_SEED_TOKEN=

# --- Site ---
# Canonical origin of the deployed site, no trailing slash. Used for
# metadata (Open Graph, canonical URLs), the sitemap, and robots.txt.
# Leave unset locally; set to the production URL on Vercel.
NEXT_PUBLIC_SITE_URL=

# --- Contact form (Phase 3) ---
# Resend API key, server-side only, from resend.com
RESEND_API_KEY=
# Inbox that receives contact form submissions (not stored in Sanity, see README)
CONTACT_RECIPIENT_EMAIL=
# Verified "from" address on your Resend domain
CONTACT_SENDER_EMAIL=
